{
  "manifest_version": 3,
  "name": "QueueBee Hospital Optimizer v1.0",
  "version": "1.0",
  "permissions": ["storage"],
  "host_permissions": ["http://10.138.119.134/*"],
  "action": { "default_popup": "popup.html" },
  "content_scripts": [{
      "matches": ["http://10.138.119.134/*"],
      "js": ["page-state.js"],
      "world": "MAIN",
      "run_at": "document_start"
  }, {
      "matches": ["http://10.138.119.134/*"],
      "js": ["content.js"]
  }]
}
